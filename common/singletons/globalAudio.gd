extends Node

#music and sound effects, kept between scenes (sounds generated by tools/sounds/generate.py)
#GlobalAudio.play("door_open")

const SOUNDS={
	"click":preload("res://sounds/click.wav"),
	"pop":preload("res://sounds/pop.wav"),
	"tick":preload("res://sounds/tick.wav"),
	"beep":preload("res://sounds/beep.wav"),
	"code_ok":preload("res://sounds/code_ok.wav"),
	"code_wrong":preload("res://sounds/code_wrong.wav"),
	"locked":preload("res://sounds/locked.wav"),
	"unlock":preload("res://sounds/unlock.wav"),
	"door_open":preload("res://sounds/door_open.wav"),
	"door_close":preload("res://sounds/door_close.wav"),
	"drawer_open":preload("res://sounds/drawer_open.wav"),
	"drawer_close":preload("res://sounds/drawer_close.wav"),
	"box_open":preload("res://sounds/box_open.wav"),
	"box_close":preload("res://sounds/box_close.wav"),
	"pickup":preload("res://sounds/pickup.wav"),
	"switch":preload("res://sounds/switch.wav"),
	"water":preload("res://sounds/water.wav"),
	"win":preload("res://sounds/win.wav"),
}
const MUSIC=preload("res://sounds/music.ogg")
const MUSIC_VOLUME_DB=-12.0
const SOUND_VOLUME_DB=-4.0
#the same sound played again sounds less mechanical with a slightly different pitch
const PITCH_VARIATION=0.06
#several sounds at the same time (a door and the info sound...)
const PLAYER_COUNT=8

const SETTINGS_FILE="user://settings.cfg"

var players=[]
var nextPlayer=0
var music=null
var enabled=true

func _ready():
	#sounds of the pause menu and the inventory (tree paused)
	process_mode=Node.PROCESS_MODE_ALWAYS

	for i in PLAYER_COUNT:
		var player=AudioStreamPlayer.new()
		player.volume_db=SOUND_VOLUME_DB
		add_child(player)
		players.append(player)

	#looped by its import settings
	music=AudioStreamPlayer.new()
	music.stream=MUSIC
	music.volume_db=MUSIC_VOLUME_DB
	add_child(music)
	music.play()

	var settings=ConfigFile.new()
	settings.load(SETTINGS_FILE)
	setEnabled(settings.get_value("game","sound",true),false)

	#every button of the game clicks (also the ones already in the tree: the autoloads loaded before)
	get_tree().node_added.connect(_on_node_added)
	for button in get_tree().root.find_children("*","BaseButton",true,false):
		_on_node_added(button)

func _on_node_added(node_):
	if node_ is BaseButton and !node_.pressed.is_connected(_on_button_pressed):
		node_.pressed.connect(_on_button_pressed)

func _on_button_pressed():
	play("click")

func play(name_,pitchVariation_=true):
	if !SOUNDS.has(name_):
		push_warning("unknown sound: "+name_)
		return
	var player=players[nextPlayer]
	nextPlayer=(nextPlayer+1)%players.size()
	player.stream=SOUNDS[name_]
	player.pitch_scale=1.0+randf_range(-PITCH_VARIATION,PITCH_VARIATION) if pitchVariation_ else 1.0
	player.play()

func isEnabled():
	return enabled

func setEnabled(enabled_,save_=true):
	enabled=enabled_
	AudioServer.set_bus_mute(AudioServer.get_bus_index("Master"),!enabled)
	if !save_:
		return
	var settings=ConfigFile.new()
	settings.load(SETTINGS_FILE)
	settings.set_value("game","sound",enabled)
	settings.save(SETTINGS_FILE)

func toggle():
	setEnabled(!enabled)
