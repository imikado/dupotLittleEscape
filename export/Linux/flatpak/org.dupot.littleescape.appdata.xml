  <name>Little Escape</name>
  <launchable type="desktop-id">org.dupot.littleescape.desktop</launchable>
  <developer id="michael.bertocchi">
    <name>Michael Bertocchi</name>
  </developer>
  <summary>Escape from the flat by solving its puzzles</summary>
  <description>
    <p>
      You are locked in a small flat: search the bedroom, the bathroom, the living room and the kitchen to find clues, keys and secret codes, and open the exit door
    </p>
    <p>
      Explore in first person with the keyboard, a gamepad or the touch controls. Available in English and French
    </p>
    <p>
      This Game was made with Godot 4.7
    </p>
  </description>
